module Courier
  module Models
    type provider_patch_params =
      {
        id: String,
        alias_: String?,
        provider: String,
        settings: ::Hash[Symbol, top],
        title: String
      }
      & Courier::Internal::Type::request_parameters

    class ProviderPatchParams < Courier::Internal::Type::BaseModel
      extend Courier::Internal::Type::RequestParameters::Converter
      include Courier::Internal::Type::RequestParameters

      attr_accessor id: String

      attr_accessor alias_: String?

      attr_reader provider: String?

      def provider=: (String) -> String

      attr_reader settings: ::Hash[Symbol, top]?

      def settings=: (::Hash[Symbol, top]) -> ::Hash[Symbol, top]

      attr_reader title: String?

      def title=: (String) -> String

      def initialize: (
        id: String,
        ?alias_: String?,
        ?provider: String,
        ?settings: ::Hash[Symbol, top],
        ?title: String,
        ?request_options: Courier::request_opts
      ) -> void

      def to_hash: -> {
        id: String,
        alias_: String?,
        provider: String,
        settings: ::Hash[Symbol, top],
        title: String,
        request_options: Courier::RequestOptions
      }
    end
  end
end
