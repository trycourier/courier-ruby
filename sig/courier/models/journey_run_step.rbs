module Courier
  module Models
    type journey_run_step =
      {
        action: String,
        error: Courier::JourneyRunStep::Error?,
        skip_reason: String?,
        status: String,
        created_at: String,
        message_id: String,
        node_id: String,
        updated_at: String
      }

    class JourneyRunStep < Courier::Internal::Type::BaseModel
      attr_accessor action: String

      attr_accessor error: Courier::JourneyRunStep::Error?

      attr_accessor skip_reason: String?

      attr_accessor status: String

      attr_reader created_at: String?

      def created_at=: (String) -> String

      attr_reader message_id: String?

      def message_id=: (String) -> String

      attr_reader node_id: String?

      def node_id=: (String) -> String

      attr_reader updated_at: String?

      def updated_at=: (String) -> String

      def initialize: (
        action: String,
        error: Courier::JourneyRunStep::Error?,
        skip_reason: String?,
        status: String,
        ?created_at: String,
        ?message_id: String,
        ?node_id: String,
        ?updated_at: String
      ) -> void

      def to_hash: -> {
        action: String,
        error: Courier::JourneyRunStep::Error?,
        skip_reason: String?,
        status: String,
        created_at: String,
        message_id: String,
        node_id: String,
        updated_at: String
      }

      type error = { message: String }

      class Error < Courier::Internal::Type::BaseModel
        attr_accessor message: String

        def initialize: (message: String) -> void

        def to_hash: -> { message: String }
      end
    end
  end
end
