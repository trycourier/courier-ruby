module Courier
  module Resources
    class Notifications
      class Previews
        class Runs
          def create: (
            String id,
            ?data: ::Hash[Symbol, top],
            ?device_ids: ::Array[String],
            ?device_set_id: String,
            ?locale: String,
            ?template_version: String,
            ?idempotency_key: String,
            ?x_idempotency_expiration: String,
            ?request_options: Courier::request_opts
          ) -> Courier::Notifications::Previews::PreviewRun

          def retrieve: (
            String preview_run_id,
            id: String,
            ?request_options: Courier::request_opts
          ) -> Courier::Notifications::Previews::PreviewRunDetail

          def list: (
            String id,
            ?cursor: String?,
            ?limit: Integer,
            ?request_options: Courier::request_opts
          ) -> Courier::Notifications::Previews::PreviewRunListResponse

          def initialize: (client: Courier::Client) -> void
        end
      end
    end
  end
end
